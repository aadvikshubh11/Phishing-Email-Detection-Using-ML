{
  "version": 2,
  "builds": [
    {
      "src": "api/predict.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/predict",
      "dest": "/api/predict.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/predict.py"
    }
  ]
}